# Application
APP_NAME="Conalca IA Transport System"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://conalcaia.conalca.com.co

# Database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ai_transport
DB_USERNAME=your_database_user
DB_PASSWORD=your_database_password

# OpenAI API (Backend)
OPENAI_API_KEY=sk-proj-your-api-key-here

# OpenAI API (Frontend - Vite)
# IMPORTANTE: Esta variable es accesible en el navegador
# Solo usar en desarrollo o con rate limits configurados
VITE_OPENAI_API_KEY=sk-proj-your-api-key-here

# Silogtran API
SILOGTRAN_API_URL=https://conalca.colombiasoftware.net
SILOGTRAN_USERNAME=your_silogtran_user
SILOGTRAN_PASSWORD=your_silogtran_password

# ElevenLabs API
ELEVENLABS_API_KEY=sk_your_elevenlabs_key
ELEVENLABS_AGENT_ID=your_agent_id

# Mail Configuration
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Cache & Session
CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_CONNECTION=database

# Broadcasting
BROADCAST_DRIVER=log

# Filesystem
FILESYSTEM_DISK=local
