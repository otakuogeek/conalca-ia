# Redirección HTTP a HTTPS para my-kontrol.online
server {
    listen 80;
    server_name my-kontrol.online www.my-kontrol.online;
    
    # Security headers even on redirect
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    
    return 301 https://$server_name$request_uri;
}

# Configuración HTTPS para my-kontrol.online
server {
    listen 443 ssl http2;
    server_name my-kontrol.online www.my-kontrol.online;

    # Certificados SSL específicos para my-kontrol.online
    ssl_certificate /etc/letsencrypt/live/my-kontrol.online/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/my-kontrol.online/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
    
    # Logs
    access_log /var/log/nginx/my-kontrol.online.access.log;
    error_log /var/log/nginx/my-kontrol.online.error.log;
    
    # Configuración de cliente
    client_max_body_size 100M;
    client_body_timeout 300s;
    client_header_timeout 300s;
    
    # ============================================
    # CONFIGURACIÓN MCP SERVER en /mcp/
    # ============================================
    
    # Configuración MCP Server en /mcp/
    location /mcp/ {
        # Remover el prefijo /mcp antes de pasarlo al servidor MCP
        rewrite ^/mcp/?(.*)$ /$1 break;
        
        proxy_pass http://127.0.0.1:18840;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_set_header X-Forwarded-Host $server_name;
        proxy_set_header X-Script-Name /mcp;
        
        # Headers específicos para MCP
        proxy_set_header X-Forwarded-Prefix /mcp;
        proxy_set_header X-Request-URI $request_uri;
        
        # Configuración de buffering (importante para streaming)
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_http_version 1.1;
        proxy_intercept_errors off;
        
        # Timeouts largos para operaciones MCP
        proxy_connect_timeout 600s;
        proxy_send_timeout 600s;
        proxy_read_timeout 600s;
        
        # WebSockets y Server-Sent Events support (para streaming)
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        
        # CORS headers para MCP
        add_header Access-Control-Allow-Origin "*" always;
        add_header Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS" always;
        add_header Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With" always;
        
        # Handle preflight requests
        if ($request_method = 'OPTIONS') {
            add_header Access-Control-Allow-Origin "*";
            add_header Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS";
            add_header Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With";
            add_header Content-Length 0;
            add_header Content-Type text/plain;
            return 200;
        }
    }
    
    # Específicamente para webhooks de ElevenLabs
    location /mcp/webhook/ {
        rewrite ^/mcp/webhook/?(.*)$ /webhook/$1 break;
        
        proxy_pass http://127.0.0.1:18840;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Prefix /mcp;
        
        # Sin buffering para webhooks
        proxy_buffering off;
        proxy_request_buffering off;
        
        # Timeouts específicos para webhooks
        proxy_connect_timeout 30s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;
    }
    
    # Health check para MCP
    location /mcp/health {
        rewrite ^/mcp/health$ /health break;
        
        proxy_pass http://127.0.0.1:18840;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        
        # Fast timeout para health checks
        proxy_connect_timeout 5s;
        proxy_send_timeout 5s;
        proxy_read_timeout 5s;
    }
    
    # ============================================
    # CONFIGURACIÓN LARAVEL EXISTENTE
    # ============================================
    
    # Configuración específica para archivos estáticos - SERVIR DIRECTAMENTE
    location /build/ {
        alias /root/conalca/public/build/;
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }
    
    # Redirigir CSS antiguo al nuevo
    location /css/app.css {
        return 301 /build/assets/app-d7bb35fd.css;
    }
    
    # Configuración para CSS directory
    location /css/ {
        alias /root/conalca/public/css/;
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }
    
    # Configuración para vendor assets (Livewire, etc.)
    location /vendor/ {
        alias /root/conalca/public/vendor/;
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }
    
    # Configuración para archivos de storage
    location /storage/ {
        alias /root/conalca/public/storage/;
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }
    
    # Configuración para archivos de uploads
    location /uploads/ {
        alias /root/conalca/public/uploads/;
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }
    
    # Handle static files directamente
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot|mp3|mp4|pdf)$ {
        root /root/conalca/public;
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }
    
    # Configuración para APIs (especialmente para ElevenLabs y OpenAI)
    location /api/ {
        proxy_pass http://127.0.0.1:18838;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_request_buffering off;
        
        # Timeouts largos para APIs
        proxy_connect_timeout 600s;
        proxy_send_timeout 600s;
        proxy_read_timeout 600s;
    }
    
    # Proxy settings para Laravel (puerto 18838) - TODO LO DEMÁS
    location / {
        proxy_pass http://127.0.0.1:18838;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_set_header X-Forwarded-Host $server_name;
        
        # Configuración de buffering
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_http_version 1.1;
        proxy_intercept_errors on;
        
        # Timeouts
        proxy_connect_timeout 300s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
        
        # WebSockets support (para Livewire)
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
    
    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer-when-downgrade" always;
    add_header Content-Security-Policy "default-src 'self' data: 'unsafe-eval' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval' *.googleapis.com *.gstatic.com; img-src 'self' data: * blob:; style-src 'self' 'unsafe-inline' *.googleapis.com *.gstatic.com; font-src 'self' data: *.googleapis.com *.gstatic.com; connect-src 'self' *.elevenlabs.ai *.openai.com" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    
    # Hide Nginx version
    server_tokens off;
}